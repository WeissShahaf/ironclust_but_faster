          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u_merge" target="u_cur">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ footer note ============ -->
        <mxCell id="foot" value="All rewind additions are additive &amp; fixes-only (healthy-path byte-identical). Detection/Sorting/Merging/Curation cores are inherited unchanged from upstream; the blue boxes are the fork's new functions + data-integrity guards (CID-01&#8230;15, DI-01&#8230;22). See logs/COMPARISON_vs_upstream.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="40" y="604" width="1360" height="34" as="geometry" />
